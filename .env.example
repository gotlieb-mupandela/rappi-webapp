# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin for auth callbacks and DPO RedirectURL / BackURL
NEXT_PUBLIC_SITE_URL=https://www.rappisportshub.com

# Google Identity Services web client. When set, the site sign-in button talks
# to accounts.google.com and then supabase.auth.signInWithIdToken. When unset,
# login keeps the Supabase OAuth redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: NAD → EUR display rate (catalog stays NAD). Default 0.05 (N$20 = €1).
# NEXT_PUBLIC_EUR_PER_NAD=0.05
# Alias: NEXT_PUBLIC_NAD_TO_EUR=0.05

# Optional: local product images base for admin previews
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Server-only DPO Pay credentials (never prefix these with NEXT_PUBLIC_)
# Same /API/v6/ host for sandbox and live. Token + ServiceType come from DPO.
# Live ServiceType from DPO (e-commerce). Sandbox Account 1 uses 54841.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=113960
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_URL=https://secure.3gdirectpay.com/payv3.php
DPO_CURRENCY=NAD
# Shared secret for DPO notify URL: /api/payments/dpo/webhook?token=...
DPO_WEBHOOK_SECRET=
# Optional N$10 payment test product. Leave unset in production.
# DPO_TEST_CHECKOUT=1
SUPABASE_SERVICE_ROLE_KEY=

# Daily stock sync (scripts/sync-stock-db.mjs) busts the storefront catalog cache
# after it writes stock. Set the same secret on Vercel (so the route accepts the
# call) and in the morning routine / GitHub Actions (so the sync can call it).
# Base URL defaults to NEXT_PUBLIC_SITE_URL when CATALOG_REVALIDATE_URL is unset.
# CATALOG_REVALIDATE_SECRET=
# CATALOG_REVALIDATE_URL=https://www.rappisportshub.com

# Meta Commerce / Pixel / Conversions API
# Feed token protects GET /api/feeds/meta-catalog (query ?token= or Bearer).
META_CATALOG_FEED_TOKEN=
# Public Pixel ID (browser). Leave empty to disable the Pixel.
NEXT_PUBLIC_META_PIXEL_ID=1080704984654769
# System User token with ads_management / events permission (server CAPI).
META_CAPI_ACCESS_TOKEN=
# Optional — Commerce Manager catalog ID, for ops reference only.
# META_CATALOG_ID=

# Store / contact (shown on /store and in the footer)
NEXT_PUBLIC_CONTACT_EMAIL=sales@rappisportshub.com
NEXT_PUBLIC_WHATSAPP_NUMBER=264818141646

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sales@rappisportshub.com
# Shared secret for Supabase Database Webhook → POST /api/push/order-status
PUSH_WEBHOOK_SECRET=

# Paid-order invoices (server). Verify rappisportshub.com in Resend before live send.
RESEND_API_KEY=
INVOICE_LEGAL_NAME=RAPPI Sports Hub
INVOICE_ADDRESS=
INVOICE_CITY=
# INVOICE_VAT_NUMBER=
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourprofile
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage
